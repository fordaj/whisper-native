# scripts/.common.env — base environment for whisper-native.
#
# Sourced by scripts/env.sh before the platform-specific env
# (.<platform>.env, e.g. .macos-arm64.env). Platform-independent
# variables live here; OS/arch specifics live there.
#
# The upstream whisper.cpp pin is the single source of truth for the
# version we build. It must match the gitlink committed at
# third_party/whisper.cpp; scripts/build.sh and scripts/release.sh
# verify the match before building.

# Project
PROJECT_NAME="whisper-native"
PROJECT_REPO="fordaj/whisper-native"
PROJECT_URL="https://github.com/fordaj/whisper-native"

# Upstream whisper.cpp pin (tag + commit the submodule must be at).
# To update: see "Updating the upstream dependency" in README.md.
WHISPER_CPP_REPO="ggml-org/whisper.cpp"
WHISPER_CPP_URL="https://github.com/ggml-org/whisper.cpp.git"
WHISPER_CPP_VERSION="v1.9.5"
WHISPER_CPP_COMMIT="d1be6fde11ac6e0407606b4e42fe72d34add8037"
WHISPER_CPP_DIR="third_party/whisper.cpp"

# Executables shipped in release archives, in build order. These are
# upstream CMake target names; adding a future upstream executable to
# the distribution is a one-line change here plus a rebuild.
WHISPER_EXECUTABLES="whisper-cli whisper-server"
